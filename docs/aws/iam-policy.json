{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAppUploadsAndDeletes",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::shortudy-assets/profiles/*",
        "arn:aws:s3:::shortudy-assets/videos/*",
        "arn:aws:s3:::shortudy-assets/thumbnails/*"
      ]
    }
  ]
}
