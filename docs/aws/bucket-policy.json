{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPublicReadForPublishedAssets",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::shortudy-assets/profiles/*",
        "arn:aws:s3:::shortudy-assets/videos/*",
        "arn:aws:s3:::shortudy-assets/thumbnails/*"
      ]
    }
  ]
}
